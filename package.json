{
  "name": "@volcengine/rtc-cli",
  "version": "0.0.6",
  "description": "VolcEngine RTC developer-workflow CLI",
  "bin": {
    "vertc": "scripts/run.js"
  },
  "scripts": {
    "postinstall": "node scripts/install.js",
    "test": "node --test scripts/*.test.js"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
